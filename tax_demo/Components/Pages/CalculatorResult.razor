@page "/result"
@inject StateService.StateContainerService stateService
@implements IDisposable
@inject TaxItemListService TaxItemListService
@inject NavigationManager NavigationManager
@inject ILogger<CalculatorInput> Logger

<PageTitle>Tax Calculator Result</PageTitle>

<h1>Tax Calculator Result</h1>

<EditForm FormName="salary-form"
          OnInvalidSubmit="HandleInvalidSubmit"
          OnValidSubmit="HandleValidSubmit"
          Model="@salary">
    <DataAnnotationsValidator />
    <label for="salary-value">Gross Annual Salary: </label>
    <InputNumber ID="salary-value" @bind-value="salary"></InputNumber>
    <ValidationMessage For="@(() => salary)"></ValidationMessage>
    <button type="submit" class="btn btn-primary">Recalculate</button>
</EditForm>

<QuickGrid Items="@taxList" title="Tax Breakdown">
    <PropertyColumn Property="@(item => item.Label)" Title="Description"></PropertyColumn>
    <PropertyColumn Property="@(item => item.Value)" Title="Description"></PropertyColumn>
</QuickGrid>

@code {
    private double? salary;
    private IQueryable<TaxItem>? taxList;

    protected override void OnInitialized()
    {
        double salary = stateService.Value;

        TaxBreakdown taxBreakdown = new TaxBreakdown(salary);
        taxList = TaxItemListService.GetTaxList(taxBreakdown);
    }

    public class SalaryInfo
    {
        [Required(ErrorMessage = "A numerical value is required")]
        [Range(1, int.MaxValue, ErrorMessage = "Salary value must be greater than 0")]
        public double? SalaryAmount { get; set; }
    }

    private void HandleInvalidSubmit()
    {
        // Triggers when form input has invalid values.

    }

    private void HandleValidSubmit()
    {
        // Triggers when form input has valid values.

        try
        {
            NavigationManager.NavigateTo($"/result");
        }
        catch (Microsoft.AspNetCore.Components.NavigationException e)
        {
            // NOTE: If executing in Debug mode, you can just continue past the exception.
            // The exception does not persist outside of Debug mode as a work around
            Logger.LogError($"Known GitHub Issue w/ NavManager NavigateTo() Method: {e}");
            NavigationManager.NavigateTo($"/result", true);
        }
    }

    public void Dispose()
    {
        stateService.OnStateChange -= StateHasChanged;
    }
}