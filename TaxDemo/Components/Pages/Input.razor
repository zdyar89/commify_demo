@page "/calculator"
@using TaxDemo.Components.Services
@inject StateContainerService stateService
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ILogger<Input> Logger
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]


<PageTitle>Tax Calculator Input</PageTitle>

<h1>Tax Calculator Input</h1>

<EditForm FormName="salary-form"
    OnInvalidSubmit="HandleInvalidSubmit"
    OnValidSubmit="HandleValidSubmit"
    Model="@salary">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <label for="salary-value">Gross Annual Salary: </label>
    <InputNumber ID="salary-value" @bind-value="salary.SalaryAmount"/>

    <button type="submit" class="btn btn-primary">Calculate</button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    protected SalaryInfo? salary { get; set; }

    private string? formErrorMessage;

    protected override void OnInitialized()
    {
        salary ??= new();
    }

    public class SalaryInfo
    {
        [Required]
        [Range(1, int.MaxValue, ErrorMessage = "A numerical value is required and must be greater than 0")]
        public double SalaryAmount { get; set; }
    }

    private void HandleInvalidSubmit(EditContext editContext)
    {
        // Triggers when EditForm input has invalid values.

        formErrorMessage = "The salary field cannot be left blank";
        var validationErrorMessages = new ValidationMessageStore(editContext);
        validationErrorMessages.Add(() => salary, formErrorMessage);

        Logger.LogError("Invalid Submission Triggered By User");
    }

    private void HandleValidSubmit()
    {
        // Triggers when EditForm input has valid values.

        try
        {
            stateService.SetValue(salary.SalaryAmount);
            NavigationManager.NavigateTo($"/result");
        }
        catch (Microsoft.AspNetCore.Components.NavigationException e)
        {
            // NOTE: If executing in Debug mode, you can just continue past the exception.
            // The exception does not persist outside of Debug mode as a work around
            Logger.LogError($"Known GitHub Issue w/ NavManager NavigateTo() Method: {e}");

            stateService.SetValue(salary.SalaryAmount);
            NavigationManager.NavigateTo($"/result", true);
        }
    }

    public void Dispose()
    {
        stateService.OnStateChange -= StateHasChanged;
    }
}